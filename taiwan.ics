# -*- coding: utf-8 -*-

"""
台灣生活行事曆
========================
功能：
1. 自動抓取行政院人事行政總處（DGPA）官方辦公日曆
2. 自動建立國定假日
3. 普通週六、週日不建立事件
4. 國定假日遇週末，依政府公告的補假日期建立：
      ○○節(補假)
5. 政府公告補班日建立：
      [補班]○○節
6. 春節依實際政府公告的放假日期，自動顯示：
      小年夜
      除夕
      初一
      初二
      初三……
   放到哪一天就顯示到哪一天，不自行延長
7. 母親節、父親節保留為一般節日備註
8. 高雄市天然災害停止上班上課資料
9. 自動產生 taiwan.ics
10. 每年自動抓「今年＋明年」，不需要手動改年份

顯示規則：
    元旦
    小年夜
    除夕
    初一
    初二
    ...
    228和平紀念日
    兒童節
    清明節
    端午節
    中秋節
    國慶日
    母親節
    父親節
    ○○節(補假)
    [補班]○○節

不使用：
    🇹🇼
    ❤️
    💙
    「台灣政府放假日」
    「國旗 國定假日」
"""

import csv
import io
import os
import re
import ssl
import time
import uuid
import urllib.request
from datetime import date, datetime, timedelta
from html.parser import HTMLParser
from urllib.parse import urljoin


# ============================================================
# 基本設定
# ============================================================

DGPA_PAGE = "https://www.dgpa.gov.tw/information?pid=12922&uid=137"

OUTPUT_FILE = "taiwan.ics"

# 高雄市天然災害停止上班上課
KAOHSIUNG_API = (
    "https://openapi.kcg.gov.tw/Api/Service/Get/"
    "95eec21d-4ee7-4920-94ff-d36727bc171f"
)

USER_AGENT = (
    "Mozilla/5.0 "
    "(Windows NT 10.0; Win64; x64) "
    "AppleWebKit/537.36 "
    "Chrome/154.0 Safari/537.36"
)

# 下載失敗時最多重試幾次
DOWNLOAD_RETRIES = 4


# ============================================================
# SSL / HTTP
# ============================================================

def create_ssl_context():
    """
    DGPA 某些 FileConversion 服務偶爾會出現憑證鏈問題。
    放寬 strict 檢查，但仍然保留 HTTPS 憑證驗證。
    """
    context = ssl.create_default_context()

    try:
        context.verify_flags &= ~ssl.VERIFY_X509_STRICT
    except Exception:
        pass

    return context


SSL_CONTEXT = create_ssl_context()


def http_get(url, timeout=30):
    """
    下載文字 / 二進位資料。
    """
    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT,
            "Accept": "*/*",
        },
    )

    last_error = None

    for attempt in range(1, DOWNLOAD_RETRIES + 1):
        try:
            with urllib.request.urlopen(
                request,
                timeout=timeout,
                context=SSL_CONTEXT,
            ) as response:
                return response.read()

        except Exception as exc:
            last_error = exc

            print(
                f"[WARN] 下載失敗 "
                f"(第 {attempt}/{DOWNLOAD_RETRIES} 次)：{url}"
            )
            print(f"       {exc}")

            if attempt < DOWNLOAD_RETRIES:
                time.sleep(attempt * 2)

    raise RuntimeError(
        f"下載失敗：{url}\n原因：{last_error}"
    )


# ============================================================
# DGPA 網頁解析
# ============================================================

class LinkParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.links = []

    def handle_starttag(self, tag, attrs):
        if tag.lower() != "a":
            return

        attrs = dict(attrs)

        href = attrs.get("href")
        text = ""

        if href:
            self.links.append((href, text))


def get_dgpa_calendar_urls():
    """
    從 DGPA 官方資料頁自動找年度辦公日曆 CSV。

    不把 2026、2027 的檔案網址永久寫死。
    DGPA 未來更新資料後，只要同一個資料頁仍提供年度 CSV，
    程式就能重新抓取。
    """

    html = http_get(DGPA_PAGE).decode(
        "utf-8",
        errors="replace",
    )

    urls = []

    # 直接找 FileConversion CSV
    pattern = re.compile(
        r'https?://[^"\']+?FileConversion\?[^"\']+?\.csv[^"\']*',
        re.IGNORECASE,
    )

    for match in pattern.findall(html):
        url = match.replace("&amp;", "&")
        urls.append(url)

    # 也處理相對網址
    parser = LinkParser()

    try:
        parser.feed(html)
    except Exception:
        pass

    for href, _ in parser.links:
        if "FileConversion" in href and ".csv" in href.lower():
            urls.append(urljoin(DGPA_PAGE, href))

    # 去重
    unique = []

    for url in urls:
        if url not in unique:
            unique.append(url)

    # 優先選「政府行政機關辦公日曆表」CSV
    calendar_urls = []

    for url in unique:
        decoded = url

        if (
            "政府行政機關辦公日曆表" in decoded
            or "辦公日曆表" in decoded
        ):
            calendar_urls.append(url)

    if not calendar_urls:
        calendar_urls = unique

    return calendar_urls


# ============================================================
# 年份 / 民國年
# ============================================================

def roc_year(year):
    return year - 1911


def extract_year_from_filename(url):
    """
    從檔名找 114 / 115 / 116 等民國年份。

    例如：
        116年中華民國政府行政機關辦公日曆表
    """

    match = re.search(r"(\d{3})年", url)

    if match:
        roc = int(match.group(1))

        if 100 <= roc <= 200:
            return roc + 1911

    # 備援：找西元四位數
    match = re.search(r"(20\d{2})", url)

    if match:
        return int(match.group(1))

    return None


# ============================================================
# CSV 解析
# ============================================================

def decode_csv(data):
    encodings = [
        "utf-8-sig",
        "utf-8",
        "big5",
        "cp950",
    ]

    for encoding in encodings:
        try:
            return data.decode(encoding)
        except UnicodeDecodeError:
            continue

    return data.decode("utf-8", errors="replace")


def find_date(value):
    """
    嘗試從欄位內容解析日期。

    支援：
        2027/01/01
        2027-01-01
        116/01/01
        1160101
        20270101
    """

    if not value:
        return None

    text = str(value).strip()

    # yyyy/mm/dd
    match = re.search(
        r"(20\d{2})[/-](\d{1,2})[/-](\d{1,2})",
        text,
    )

    if match:
        try:
            return date(
                int(match.group(1)),
                int(match.group(2)),
                int(match.group(3)),
            )
        except ValueError:
            pass

    # ROC yyyy/mm/dd
    match = re.search(
        r"(?<!\d)(\d{3})[/-](\d{1,2})[/-](\d{1,2})(?!\d)",
        text,
    )

    if match:
        try:
            return date(
                int(match.group(1)) + 1911,
                int(match.group(2)),
                int(match.group(3)),
            )
        except ValueError:
            pass

    # yyyyMMdd
    match = re.search(
        r"(?<!\d)(20\d{2})(\d{2})(\d{2})(?!\d)",
        text,
    )

    if match:
        try:
            return date(
                int(match.group(1)),
                int(match.group(2)),
                int(match.group(3)),
            )
        except ValueError:
            pass

    return None


def normalize_text(text):
    if text is None:
        return ""

    text = str(text)

    text = text.replace("\ufeff", "")
    text = text.replace("\u3000", " ")
    text = text.strip()

    return text


def read_calendar_csv(data):
    """
    讀取 DGPA CSV。

    不假設欄位名稱固定。
    會自動尋找：
        日期
        是否放假
        說明 / 備註
    """

    text = decode_csv(data)

    sample = text[:10000]

    try:
        dialect = csv.Sniffer().sniff(
            sample,
            delimiters=",\t",
        )
    except Exception:
        dialect = csv.excel

    reader = csv.reader(
        io.StringIO(text),
        dialect,
    )

    rows = list(reader)

    if not rows:
        return []

    # 找標題列
    header_index = 0

    for i, row in enumerate(rows[:10]):
        joined = "".join(normalize_text(x) for x in row)

        if (
            "日期" in joined
            or "Date" in joined
            or "星期" in joined
        ):
            header_index = i
            break

    header = [
        normalize_text(x)
        for x in rows[header_index]
    ]

    records = []

    for row in rows[header_index + 1:]:
        if not row:
            continue

        # 補足欄位
        if len(row) < len(header):
            row = row + [""] * (len(header) - len(row))

        record = {}

        for i, name in enumerate(header):
            if not name:
                name = f"欄位{i + 1}"

            record[name] = normalize_text(row[i])

        records.append(record)

    return records


def get_record_date(record):
    """
    從一列資料找到日期。
    """

    # 優先看名稱像日期的欄位
    priority = []

    for key in record:
        if any(
            word in key
            for word in [
                "日期",
                "date",
                "Date",
            ]
        ):
            priority.append(key)

    priority += list(record.keys())

    seen = set()

    for key in priority:
        if key in seen:
            continue

        seen.add(key)

        d = find_date(record.get(key, ""))

        if d:
            return d

    return None


def record_text(record):
    return " ".join(
        normalize_text(v)
        for v in record.values()
        if normalize_text(v)
    )


def get_holiday_flag(record):
    """
    判斷該日是否為政府公告放假日。

    盡量支援不同年度 CSV 欄位格式。
    """

    text = record_text(record)

    # 明確的放假文字
    holiday_words = [
        "放假",
        "休假",
        "假日",
        "紀念日",
        "節日",
    ]

    work_words = [
        "補班",
        "補行上班",
        "上班",
        "辦公",
        "工作日",
    ]

    # 欄位值優先判斷
    for key, value in record.items():
        key_text = normalize_text(key)
        value_text = normalize_text(value)

        if any(
            word in key_text
            for word in [
                "是否放假",
                "放假",
                "工作日",
                "辦公日",
            ]
        ):
            if any(
                word in value_text
                for word in [
                    "是",
                    "放假",
                    "休假",
                    "假日",
                ]
            ):
                return True

            if any(
                word in value_text
                for word in [
                    "否",
                    "上班",
                    "工作",
                    "辦公",
                ]
            ):
                return False

    if any(word in text for word in work_words):
        return False

    if any(word in text for word in holiday_words):
        return True

    return None


# ============================================================
# 節日名稱
# ============================================================

def clean_government_name(text):
    """
    將政府 CSV 的原始描述轉成乾淨名稱。
    """

    text = normalize_text(text)

    if not text:
        return ""

    # 移除常見的國旗 / emoji / 裝飾
    text = re.sub(
        r"[\U0001F1E6-\U0001F1FF]{2}",
        "",
        text,
    )

    text = text.replace("🇹🇼", "")
    text = text.replace("❤️", "")
    text = text.replace("❤", "")
    text = text.replace("💙", "")

    # 不讓「台灣政府放假日」這種總標題進入事件
    if "台灣政府放假日" in text:
        return ""

    # 常見行政用詞清理
    replacements = [
        ("中華民國", ""),
        ("政府行政機關", ""),
        ("行政機關", ""),
        ("辦公日曆表", ""),
        ("放假日", ""),
        ("放假", ""),
    ]

    for old, new in replacements:
        text = text.replace(old, new)

    text = text.strip(" -_：:（）()")

    return text


def detect_base_holiday_name(record):
    """
    從政府資料找節日名稱。
    """

    text = record_text(record)

    # 補班不是一般節日名稱
    if "補班" in text or "補行上班" in text:
        return None

    # 春節
    if any(
        x in text
        for x in [
            "春節",
            "春節假期",
            "農曆春節",
            "農曆年",
        ]
    ):
        return "春節"

    rules = [
        (["元旦", "開國紀念日"], "元旦"),
        (["228", "二二八", "和平紀念日"], "228和平紀念日"),
        (["兒童節"], "兒童節"),
        (["清明節", "民族掃墓節"], "清明節"),
        (["端午節"], "端午節"),
        (["中秋節"], "中秋節"),
        (["國慶日", "國慶"], "國慶日"),
        (["勞動節"], "勞動節"),
        (["臺灣光復節", "台灣光復節"], "臺灣光復節"),
        (["行憲紀念日"], "行憲紀念日"),
        (["孔子誕辰紀念日"], "孔子誕辰紀念日"),
    ]

    for keywords, name in rules:
        if any(keyword in text for keyword in keywords):
            return name

    # 備援：從欄位中找看起來像節日的名稱
    for value in record.values():
        value = clean_government_name(value)

        if not value:
            continue

        if len(value) <= 30:
            if any(
                x in value
                for x in [
                    "節",
                    "紀念日",
                    "元旦",
                    "國慶",
                ]
            ):
                return value

    return None


# ============================================================
# 農曆春節
# ============================================================

def load_lunardate():
    """
    lunardate 由 GitHub Actions 安裝。
    """

    try:
        from lunardate import LunarDate

        return LunarDate

    except ImportError:
        raise RuntimeError(
            "找不到 lunardate。\n"
            "請確認 GitHub Actions 已執行：\n"
            "pip install lunardate"
        )


def chinese_day_name(day):
    """
    1 -> 初一
    2 -> 初二
    ...
    10 -> 初十
    11 -> 十一
    20 -> 二十
    21 -> 廿一
    30 -> 三十
    """

    if day <= 10:
        if day == 1:
            return "初一"
        if day == 2:
            return "初二"
        if day == 3:
            return "初三"
        if day == 4:
            return "初四"
        if day == 5:
            return "初五"
        if day == 6:
            return "初六"
        if day == 7:
            return "初七"
        if day == 8:
            return "初八"
        if day == 9:
            return "初九"
        return "初十"

    if day < 20:
        return f"十一" if day == 11 else (
            f"十二" if day == 12 else
            f"十三" if day == 13 else
            f"十四" if day == 14 else
            f"十五" if day == 15 else
            f"十六" if day == 16 else
            f"十七" if day == 17 else
            f"十八" if day == 18 else
            f"十九"
        )

    if day == 20:
        return "二十"

    if day < 30:
        return f"廿{day - 20}"

    return "三十"


def get_spring_festival_name(solar_date):
    """
    依陽曆日期轉農曆。

    規則：
    - 農曆正月初一開始：初一、初二……
    - 農曆除夕：除夕
    - 除夕前一天：小年夜

    注意：
    「是否顯示」不在這裡決定。
    是否顯示完全由 DGPA 官方放假資料決定。
    """

    LunarDate = load_lunardate()

    lunar = LunarDate.from_solar_date(
        solar_date.year,
        solar_date.month,
        solar_date.day,
    )

    # 農曆正月
    if lunar.month == 1 and not lunar.is_leap_month:
        return chinese_day_name(lunar.day)

    # 除夕 / 小年夜
    #
    # 農曆十二月最後一天 = 除夕
    # 農曆十二月倒數第二天 = 小年夜
    if lunar.month == 12 and not lunar.is_leap_month:
        try:
            next_day = LunarDate.from_solar_date(
                solar_date.year,
                solar_date.month,
                solar_date.day + 1,
            )

            # 隔天進入正月，代表今天是除夕
            if (
                next_day.month == 1
                and not next_day.is_leap_month
                and next_day.day == 1
            ):
                return "除夕"

        except Exception:
            pass

        try:
            tomorrow = solar_date + timedelta(days=1)

            next_lunar = LunarDate.from_solar_date(
                tomorrow.year,
                tomorrow.month,
                tomorrow.day,
            )

            if (
                next_lunar.month == 12
                and not next_lunar.is_leap_month
            ):
                # 如果明天是除夕，今天就是小年夜
                after_tomorrow = tomorrow + timedelta(days=1)

                after_lunar = LunarDate.from_solar_date(
                    after_tomorrow.year,
                    after_tomorrow.month,
                    after_tomorrow.day,
                )

                if (
                    after_lunar.month == 1
                    and not after_lunar.is_leap_month
                    and after_lunar.day == 1
                ):
                    return "小年夜"

        except Exception:
            pass

    return None


# ============================================================
# 補假 / 補班
# ============================================================

def is_makeup_workday(record):
    text = record_text(record)

    return any(
        x in text
        for x in [
            "補班",
            "補行上班",
            "補行辦公",
            "上班日",
            "工作日",
        ]
    )


def is_makeup_holiday(record):
    text = record_text(record)

    return any(
        x in text
        for x in [
            "補假",
            "補休",
            "調整放假",
        ]
    )


# ============================================================
# 建立官方事件
# ============================================================

def parse_official_year(url):
    """
    下載並解析一個年度官方行事曆。
    """

    print(f"[下載] {url}")

    data = http_get(url, timeout=40)

    records = read_calendar_csv(data)

    if not records:
        print("[WARN] CSV 沒有有效資料")
        return []

    events = []

    for record in records:
        d = get_record_date(record)

        if not d:
            continue

        holiday_flag = get_holiday_flag(record)

        # 沒有明確放假資訊，不納入
        if holiday_flag is False:
            continue

        text = record_text(record)

        # ----------------------------------------------------
        # 補班
        # ----------------------------------------------------
        if is_makeup_workday(record):
            base_name = detect_base_holiday_name(record)

            if not base_name:
                # 如果政府原始資料只有「補班」，
                # 就保留最合理的通用名稱。
                base_name = "補班"

            if base_name == "春節":
                try:
                    lunar_name = get_spring_festival_name(d)

                    if lunar_name:
                        base_name = lunar_name
                except Exception:
                    pass

            events.append(
                {
                    "date": d,
                    "name": f"[補班]{base_name}",
                    "type": "makeup_workday",
                }
            )

            continue

        # ----------------------------------------------------
        # 正常放假 / 補假
        # ----------------------------------------------------
        base_name = detect_base_holiday_name(record)

        if not base_name:
            # 如果只是普通週末或無節日資料，不建立事件
            continue

        # 春節：
        # 名稱完全依實際農曆日期決定。
        if base_name == "春節":
            try:
                lunar_name = get_spring_festival_name(d)

                if lunar_name:
                    base_name = lunar_name
            except Exception as exc:
                print(
                    f"[WARN] 農曆轉換失敗：{d} / {exc}"
                )

        # 補假
        if is_makeup_holiday(record):
            name = f"{base_name}(補假)"
        else:
            name = base_name

        events.append(
            {
                "date": d,
                "name": name,
                "type": "holiday",
            }
        )

    return events


# ============================================================
# 官方資料 URL 選擇
# ============================================================

def get_year_urls(target_years):
    """
    從 DGPA 官方頁面找出今年＋明年的年度 CSV。
    """

    urls = get_dgpa_calendar_urls()

    result = {}

    for url in urls:
        year = extract_year_from_filename(url)

        if year in target_years:
            # Google 行事曆專用檔通常也存在。
            # 優先一般 UTF-8 CSV。
            score = 0

            if "utf8bom" in url.lower():
                score += 10

            if "google" in url.lower():
                score -= 20

            if "辦公日曆表" in url:
                score += 10

            if year not in result:
                result[year] = (score, url)
            else:
                if score > result[year][0]:
                    result[year] = (score, url)

    return {
        year: item[1]
        for year, item in result.items()
    }


# ============================================================
# 母親節 / 父親節
# ============================================================

def get_mothers_day(year):
    """
    母親節：五月第二個星期日
    """

    d = date(year, 5, 1)

    while d.weekday() != 6:
        d += timedelta(days=1)

    return d + timedelta(days=7)


def get_fathers_day(year):
    """
    台灣常見父親節：8月8日
    """

    return date(year, 8, 8)


# ============================================================
# 高雄停班停課
# ============================================================

def get_kaohsiung_disaster_events():
    """
    嘗試抓取高雄市天然災害停止上班上課資料。

    API 若暫時無法連線：
        不讓整個行事曆失敗。
    """

    try:
        print("[高雄] 取得天然災害停班停課資料")

        data = http_get(
            KAOHSIUNG_API,
            timeout=15,
        )

        text = data.decode(
            "utf-8",
            errors="replace",
        )

        events = []

        # 常見 JSON 中的日期抓取
        date_matches = re.findall(
            r"(20\d{2})[-/](\d{1,2})[-/](\d{1,2})",
            text,
        )

        seen = set()

        for y, m, d in date_matches:
            try:
                event_date = date(
                    int(y),
                    int(m),
                    int(d),
                )
            except ValueError:
                continue

            if event_date in seen:
                continue

            seen.add(event_date)

            # 找日期附近的文字
            pos = text.find(
                f"{y}-{int(m):02d}-{int(d):02d}"
            )

            nearby = text[
                max(0, pos - 500):
                pos + 800
            ]

            # 只抓高雄停止上班上課相關訊息
            if any(
                x in nearby
                for x in [
                    "停止上班",
                    "停止上課",
                    "停班",
                    "停課",
                ]
            ):
                events.append(
                    {
                        "date": event_date,
                        "name": "高雄停班停課",
                        "type": "disaster",
                    }
                )

        return events

    except Exception as exc:
        print(
            f"[WARN] 高雄停班停課資料取得失敗：{exc}"
        )
        return []


# ============================================================
# 去重 / 整理事件
# ============================================================

def deduplicate_events(events):
    """
    同一天同名稱只保留一次。
    """

    result = []
    seen = set()

    for event in sorted(
        events,
        key=lambda x: (
            x["date"],
            x["name"],
        ),
    ):
        key = (
            event["date"],
            event["name"],
        )

        if key in seen:
            continue

        seen.add(key)
        result.append(event)

    return result


# ============================================================
# ICS
# ============================================================

def escape_ics_text(text):
    """
    RFC 5545 文字轉義。
    """

    text = str(text)

    text = text.replace("\\", "\\\\")
    text = text.replace(";", "\\;")
    text = text.replace(",", "\\,")
    text = text.replace("\r\n", "\\n")
    text = text.replace("\n", "\\n")
    text = text.replace("\r", "\\n")

    return text


def ics_uid(event_date, name):
    """
    穩定 UID。

    同一天同名稱的事件，
    每次重新生成仍使用同一 UID。
    """

    raw = f"taiwan-calendar:{event_date.isoformat()}:{name}"

    return (
        uuid.uuid5(
            uuid.NAMESPACE_URL,
            raw,
        )
    )


def make_ics(events):
    """
    建立全天事件 ICS。
    """

    lines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Taiwan Life Calendar//TW//",
        "CALSCALE:GREGORIAN",
        "METHOD:PUBLISH",
        "X-WR-CALNAME:台灣生活行事曆",
        "X-WR-TIMEZONE:Asia/Taipei",
    ]

    now = datetime.utcnow().strftime(
        "%Y%m%dT%H%M%SZ"
    )

    for event in events:
        d = event["date"]
        name = event["name"]

        end_date = d + timedelta(days=1)

        uid = ics_uid(d, name)

        lines.extend(
            [
                "BEGIN:VEVENT",
                f"UID:{uid}@taiwan-calendar",
                f"DTSTAMP:{now}",
                f"DTSTART;VALUE=DATE:{d.strftime('%Y%m%d')}",
                f"DTEND;VALUE=DATE:{end_date.strftime('%Y%m%d')}",
                f"SUMMARY:{escape_ics_text(name)}",
                "END:VEVENT",
            ]
        )

    lines.append("END:VCALENDAR")

    return "\r\n".join(lines) + "\r\n"


# ============================================================
# 主程式
# ============================================================

def main():
    today = date.today()

    current_year = today.year
    next_year = current_year + 1

    target_years = {
        current_year,
        next_year,
    }

    print("=" * 60)
    print("台灣生活行事曆開始更新")
    print("=" * 60)

    print(
        f"[年份] {current_year} + {next_year}"
    )

    # --------------------------------------------------------
    # 官方 DGPA 行事曆
    # --------------------------------------------------------

    year_urls = get_year_urls(target_years)

    print(
        f"[官方] 找到年度資料："
        f"{sorted(year_urls.keys())}"
    )

    all_events = []

    for year in sorted(target_years):
        url = year_urls.get(year)

        if not url:
            print(
                f"[WARN] 找不到 {year} 年官方辦公日曆"
            )
            continue

        try:
            events = parse_official_year(url)

            print(
                f"[完成] {year} 官方事件："
                f"{len(events)} 筆"
            )

            all_events.extend(events)

        except Exception as exc:
            print(
                f"[ERROR] {year} 官方資料處理失敗："
                f"{exc}"
            )

    # --------------------------------------------------------
    # 母親節 / 父親節
    # --------------------------------------------------------

    for year in sorted(target_years):
        mother = get_mothers_day(year)
        father = get_fathers_day(year)

        all_events.append(
            {
                "date": mother,
                "name": "母親節",
                "type": "note",
            }
        )

        all_events.append(
            {
                "date": father,
                "name": "父親節",
                "type": "note",
            }
        )

    # --------------------------------------------------------
    # 高雄停班停課
    # --------------------------------------------------------

    kaohsiung_events = get_kaohsiung_disaster_events()

    all_events.extend(kaohsiung_events)

    # --------------------------------------------------------
    # 去重
    # --------------------------------------------------------

    all_events = deduplicate_events(all_events)

    # --------------------------------------------------------
    # 再次保護：
    # 普通週六、週日不能出現
    #
    # 但國定假日、補假、補班、母親節、父親節、
    # 高雄停班停課，即使落在週末也保留。
    # --------------------------------------------------------

    allowed_types = {
        "holiday",
        "makeup_workday",
        "note",
        "disaster",
    }

    filtered_events = []

    for event in all_events:
        if event["type"] in allowed_types:
            filtered_events.append(event)

    all_events = filtered_events

    # --------------------------------------------------------
    # 產生 ICS
    # --------------------------------------------------------

    ics = make_ics(all_events)

    with open(
        OUTPUT_FILE,
        "w",
        encoding="utf-8",
        newline="",
    ) as f:
        f.write(ics)

    # --------------------------------------------------------
    # 統計
    # --------------------------------------------------------

    official_count = sum(
        1
        for x in all_events
        if x["type"] == "holiday"
    )

    makeup_holiday_count = sum(
        1
        for x in all_events
        if x["name"].endswith("(補假)")
    )

    makeup_workday_count = sum(
        1
        for x in all_events
        if x["type"] == "makeup_workday"
    )

    mother_count = sum(
        1
        for x in all_events
        if x["name"] == "母親節"
    )

    father_count = sum(
        1
        for x in all_events
        if x["name"] == "父親節"
    )

    disaster_count = sum(
        1
        for x in all_events
        if x["type"] == "disaster"
    )

    print()
    print("=" * 60)
    print("[完成] taiwan.ics 已產生")
    print("=" * 60)

    print(
        f"[統計] 一般國定假日："
        f"{official_count} 筆"
    )

    print(
        f"[統計] 補假："
        f"{makeup_holiday_count} 筆"
    )

    print(
        f"[統計] 補班："
        f"{makeup_workday_count} 筆"
    )

    print(
        f"[統計] 母親節："
        f"{mother_count} 筆"
    )

    print(
        f"[統計] 父親節："
        f"{father_count} 筆"
    )

    print(
        f"[統計] 高雄停班停課："
        f"{disaster_count} 筆"
    )

    print(
        f"[統計] 總行事曆事件："
        f"{len(all_events)} 個"
    )

    print()
    print("[檢查] 前 30 個事件：")

    for event in all_events[:30]:
        print(
            f"  {event['date']}  "
            f"{event['name']}"
        )


if __name__ == "__main__":
    main()
