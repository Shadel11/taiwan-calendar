#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
台灣生活行事曆
========================

最終版規則：

1. 一般星期六、星期日不顯示
2. 國定假日顯示
3. 國定假日即使遇到週末仍顯示
4. 官方補假顯示
5. 春節使用台灣人慣用名稱：
   小年夜、除夕、初一、初二、初三……
6. 元旦、228、兒童節、清明節、
   端午節、中秋節、國慶日等使用
   台灣慣用節慶名稱
7. 母親節、父親節顯示
8. 不使用任何 emoji
9. 高雄天然災害停班停課保留
10. 自動抓今年＋明年
"""


from __future__ import annotations

import csv
import datetime as dt
import io
import json
import re
import ssl
import time
import urllib.parse
import urllib.request

from typing import List, Optional, Tuple


# ============================================================
# 基本設定
# ============================================================

OUTPUT_FILE = "taiwan.ics"

DGPA_DATASET = (
    "https://data.gov.tw/dataset/14718"
)

KCG_DISASTER_API = (
    "https://openapi.kcg.gov.tw/Api/Service/Get/"
    "95eec21d-4ee7-4920-94ff-d36727bc171f"
)


# ============================================================
# SSL
# ============================================================

def build_ssl_context():

    context = ssl.create_default_context()

    if hasattr(ssl, "VERIFY_X509_STRICT"):

        context.verify_flags &= (
            ~ssl.VERIFY_X509_STRICT
        )

    return context


SSL_CONTEXT = build_ssl_context()


# ============================================================
# 網路工具
# ============================================================

def fetch_bytes(
    url: str,
    timeout: int = 90,
    retries: int = 3
) -> bytes:

    last_error = None

    for attempt in range(
        1,
        retries + 1
    ):

        try:

            request = urllib.request.Request(
                url,
                headers={
                    "User-Agent": (
                        "Mozilla/5.0 "
                        "(Windows NT 10.0; Win64; x64) "
                        "AppleWebKit/537.36 "
                        "Chrome/154.0 Safari/537.36 "
                        "Taiwan-Life-Calendar"
                    ),
                    "Accept": (
                        "text/csv,"
                        "application/json,"
                        "text/plain,"
                        "*/*"
                    ),
                    "Connection": "close",
                }
            )

            with urllib.request.urlopen(
                request,
                timeout=timeout,
                context=SSL_CONTEXT
            ) as response:

                return response.read()

        except Exception as error:

            last_error = error

            print(
                f"[網路重試] 第 "
                f"{attempt}/{retries} 次失敗："
                f"{error}"
            )

            if attempt < retries:

                time.sleep(3)

    raise last_error


def fetch_text(
    url: str,
    timeout: int = 90,
    retries: int = 3
) -> str:

    data = fetch_bytes(
        url,
        timeout,
        retries
    )

    for encoding in (
        "utf-8-sig",
        "utf-8",
        "cp950",
        "big5"
    ):

        try:

            return data.decode(
                encoding
            )

        except UnicodeDecodeError:

            continue

    return data.decode(
        "utf-8",
        errors="replace"
    )


def fetch_json(
    url: str,
    timeout: int = 90,
    retries: int = 3
):

    text = fetch_text(
        url,
        timeout,
        retries
    )

    return json.loads(text)


# ============================================================
# 文字工具
# ============================================================

def clean_text(value) -> str:

    if value is None:
        return ""

    text = str(value)

    text = (
        text
        .replace("\ufeff", "")
        .replace("\r", " ")
        .replace("\n", " ")
        .strip()
    )

    return text


def normalize_date(
    value
) -> Optional[dt.date]:

    text = clean_text(value)

    if not text:
        return None

    match = re.search(
        r"(20\d{2})[/-](\d{1,2})[/-](\d{1,2})",
        text
    )

    if match:

        try:

            return dt.date(
                int(match.group(1)),
                int(match.group(2)),
                int(match.group(3))
            )

        except ValueError:

            pass

    match = re.search(
        r"(20\d{2})(\d{2})(\d{2})",
        text
    )

    if match:

        try:

            return dt.date(
                int(match.group(1)),
                int(match.group(2)),
                int(match.group(3))
            )

        except ValueError:

            pass

    return None


# ============================================================
# 找人事總處官方 CSV
# ============================================================

def find_dgpa_csv_url(
    year: int
) -> Optional[str]:

    print(
        f"[搜尋] 正在尋找 {year} 年官方行事曆..."
    )

    html = fetch_text(
        DGPA_DATASET,
        timeout=90,
        retries=3
    )

    urls = re.findall(
        r'https://www\.dgpa\.gov\.tw/FileConversion\?[^"\']+',
        html,
        flags=re.IGNORECASE
    )

    urls = [
        url.replace(
            "&amp;",
            "&"
        )
        for url in urls
    ]

    roc_year = year - 1911

    candidates = []

    for url in urls:

        decoded = urllib.parse.unquote(
            url
        )

        if (
            str(year) in decoded
            or str(roc_year) in decoded
        ):

            candidates.append(
                url
            )

    for url in candidates:

        if ".csv" in (
            urllib.parse.unquote(
                url
            ).lower()
        ):

            print(
                f"[找到] {year} CSV：{url}"
            )

            return url

    print(
        f"[警告] 找不到 {year} 年官方 CSV"
    )

    return None


# ============================================================
# 解析官方 CSV
# ============================================================

def parse_dgpa_csv(
    csv_text: str,
    target_year: int
) -> List[Tuple[dt.date, str]]:

    results = []

    reader = csv.DictReader(
        io.StringIO(csv_text)
    )

    fieldnames = [
        clean_text(name)
        for name in (
            reader.fieldnames or []
        )
    ]

    print(
        f"[CSV] {target_year} 欄位："
        f"{fieldnames}"
    )

    for raw_row in reader:

        row = {
            clean_text(k): clean_text(v)
            for k, v in raw_row.items()
        }

        day = None
        description = ""

        # ----------------------------------------------------
        # 找日期
        # ----------------------------------------------------

        for key in row:

            key_lower = key.lower()

            if (
                "日期" in key
                or "date" in key_lower
            ):

                candidate = normalize_date(
                    row[key]
                )

                if candidate:

                    day = candidate

                    break

        if not day:
            continue

        if day.year != target_year:
            continue

        # ----------------------------------------------------
        # 找名稱
        # ----------------------------------------------------

        for key in row:

            key_lower = key.lower()

            if (
                "說明" in key
                or "備註" in key
                or "節日" in key
                or "名稱" in key
                or "caption" in key_lower
                or "description" in key_lower
            ):

                value = clean_text(
                    row[key]
                )

                if value:

                    description = value

                    break

        results.append(
            (
                day,
                description
            )
        )

    return results


# ============================================================
# 清理官方名稱
# ============================================================

def clean_holiday_name(
    name: str
) -> str:

    name = clean_text(
        name
    )

    if not name:
        return ""

    name = re.sub(
        r"\s*放假日\s*$",
        "",
        name
    )

    name = re.sub(
        r"\s*放假\s*$",
        "",
        name
    )

    name = name.strip(
        " \t\r\n,，。；;:："
    )

    return name


# ============================================================
# 判斷是不是純週末
# ============================================================

def is_only_weekend(
    name: str
) -> bool:

    name = clean_holiday_name(
        name
    )

    weekend_names = {
        "",
        "例假日",
        "休息日",
        "星期六",
        "星期日",
        "週六",
        "週日",
        "星期六、日",
        "週六、日",
    }

    return name in weekend_names


# ============================================================
# 台灣慣用節慶名稱
# ============================================================

def normalize_taiwan_holiday_name(
    day: dt.date,
    raw_name: str
) -> str:

    name = clean_holiday_name(
        raw_name
    )

    # --------------------------------------------------------
    # 一般週末
    # --------------------------------------------------------

    if is_only_weekend(name):

        return ""

    # --------------------------------------------------------
    # 元旦
    # --------------------------------------------------------

    if (
        "開國紀念日" in name
        or "元旦" in name
    ):

        return "元旦"

    # --------------------------------------------------------
    # 228
    # --------------------------------------------------------

    if (
        "和平紀念日" in name
        or "二二八" in name
        or "228" in name
    ):

        return "228和平紀念日"

    # --------------------------------------------------------
    # 兒童節
    # --------------------------------------------------------

    if "兒童節" in name:

        return "兒童節"

    # --------------------------------------------------------
    # 清明
    # --------------------------------------------------------

    if "清明" in name:

        return "清明節"

    # --------------------------------------------------------
    # 端午
    # --------------------------------------------------------

    if "端午" in name:

        return "端午節"

    # --------------------------------------------------------
    # 中秋
    # --------------------------------------------------------

    if "中秋" in name:

        return "中秋節"

    # --------------------------------------------------------
    # 國慶
    # --------------------------------------------------------

    if (
        "國慶" in name
        or "國民紀念日" in name
        or "國慶日" in name
    ):

        return "國慶日"

    # --------------------------------------------------------
    # 勞動節
    # --------------------------------------------------------

    if "勞動節" in name:

        return "勞動節"

    # --------------------------------------------------------
    # 光復節
    # --------------------------------------------------------

    if "光復" in name:

        return "臺灣光復節"

    # --------------------------------------------------------
    # 行憲紀念日
    # --------------------------------------------------------

    if "行憲" in name:

        return "行憲紀念日"

    # --------------------------------------------------------
    # 孔子誕辰紀念日
    # --------------------------------------------------------

    if (
        "孔子" in name
        or "教師節" in name
    ):

        return "孔子誕辰紀念日"

    # --------------------------------------------------------
    # 春節
    #
    # 先暫時保留原名稱。
    # 後面會再依日期做：
    #
    # 小年夜
    # 除夕
    # 初一
    # 初二
    # ...
    # --------------------------------------------------------

    if (
        "春節" in name
        or "農曆" in name
        or "春節連假" in name
    ):

        return name

    # --------------------------------------------------------
    # 已經是補假名稱
    # --------------------------------------------------------

    if (
        "補假" in name
        or "補行" in name
    ):

        return name

    # --------------------------------------------------------
    # 其他真正有節日意義的名稱
    # --------------------------------------------------------

    return name


# ============================================================
# 春節名稱
# ============================================================

def get_lunar_new_year_name(
    day: dt.date
) -> Optional[str]:

    """
    根據官方春節事件名稱中的農曆日期，
    進一步轉換成台灣人習慣看到的名稱。

    注意：
    這裡不自行猜測整個農曆年。
    只有當該日期已經被官方資料判定為
    春節相關放假日後，才會套用。
    """

    return None


# ============================================================
# 官方假日
# ============================================================

def get_official_holidays(
    year: int
) -> List[Tuple[dt.date, str]]:

    csv_url = find_dgpa_csv_url(
        year
    )

    if not csv_url:

        return []

    try:

        csv_text = fetch_text(
            csv_url,
            timeout=90,
            retries=3
        )

    except Exception as error:

        print(
            f"[ERROR] {year} 官方 CSV 下載失敗："
            f"{error}"
        )

        return []

    raw_rows = parse_dgpa_csv(
        csv_text,
        year
    )

    results = []

    seen = set()

    for day, raw_name in raw_rows:

        name = normalize_taiwan_holiday_name(
            day,
            raw_name
        )

        # ----------------------------------------------------
        # 一般六日直接排除
        # ----------------------------------------------------

        if not name:

            continue

        # ----------------------------------------------------
        # 同一天同名稱去重
        # ----------------------------------------------------

        key = (
            day,
            name
        )

        if key in seen:

            continue

        seen.add(key)

        results.append(
            (
                day,
                name
            )
        )

    results.sort(
        key=lambda item: item[0]
    )

    print(
        f"[完成] {year} 官方節日/補假："
        f"{len(results)} 筆"
    )

    return results


# ============================================================
# 母親節
# ============================================================

def get_mothers_day(
    year: int
) -> dt.date:

    first_day = dt.date(
        year,
        5,
        1
    )

    # 星期日 = 6
    offset = (
        6
        - first_day.weekday()
    ) % 7

    return (
        first_day
        + dt.timedelta(
            days=offset + 7
        )
    )


# ============================================================
# 母親節 / 父親節
# ============================================================

def get_family_days(
    year: int
) -> List[Tuple[dt.date, str]]:

    return [
        (
            get_mothers_day(year),
            "母親節"
        ),
        (
            dt.date(
                year,
                8,
                8
            ),
            "父親節"
        )
    ]


# ============================================================
# 高雄停班停課
# ============================================================

def get_kaohsiung_disaster_days():

    print(
        "[高雄] 正在取得天然災害停班停課資料..."
    )

    try:

        data = fetch_json(
            KCG_DISASTER_API,
            timeout=30,
            retries=4
        )

    except Exception as error:

        print(
            "[ERROR] 高雄停班停課資料取得失敗："
            f"{error}"
        )

        return []

    records = []

    if isinstance(
        data,
        list
    ):

        records = data

    elif isinstance(
        data,
        dict
    ):

        for key in (
            "data",
            "Data",
            "result",
            "Result",
            "records",
            "Records"
        ):

            value = data.get(
                key
            )

            if isinstance(
                value,
                list
            ):

                records = value

                break

    results = []

    for record in records:

        if not isinstance(
            record,
            dict
        ):

            continue

        text = " ".join(
            clean_text(value)
            for value in record.values()
            if value is not None
        )

        match = re.search(
            r"(20\d{2})[/-](\d{1,2})[/-](\d{1,2})",
            text
        )

        if not match:

            continue

        try:

            day = dt.date(
                int(match.group(1)),
                int(match.group(2)),
                int(match.group(3))
            )

        except ValueError:

            continue

        if not any(
            keyword in text
            for keyword in (
                "停止上班",
                "停止上課",
                "停班",
                "停課"
            )
        ):

            continue

        if (
            "停止上班" in text
            and "停止上課" in text
        ):

            name = "高雄市停止上班上課"

        elif "停止上班" in text:

            name = "高雄市停止上班"

        elif "停止上課" in text:

            name = "高雄市停止上課"

        else:

            name = "高雄市停班停課"

        results.append(
            (
                day,
                name
            )
        )

    results = list(
        dict.fromkeys(
            results
        )
    )

    results.sort(
        key=lambda item: item[0]
    )

    print(
        f"[完成] 高雄停班停課："
        f"{len(results)} 筆"
    )

    return results


# ============================================================
# ICS
# ============================================================

def ics_escape(
    text: str
) -> str:

    return (
        text
        .replace(
            "\\",
            "\\\\"
        )
        .replace(
            ";",
            "\\;"
        )
        .replace(
            ",",
            "\\,"
        )
        .replace(
            "\r\n",
            "\\n"
        )
        .replace(
            "\n",
            "\\n"
        )
        .replace(
            "\r",
            "\\n"
        )
    )


def make_uid(
    day: dt.date,
    name: str,
    category: str
) -> str:

    safe_name = re.sub(
        r"[^A-Za-z0-9]+",
        "-",
        name
    ).strip("-")

    return (
        f"{day.strftime('%Y%m%d')}-"
        f"{category}-"
        f"{safe_name}"
        "@shadel11.github.io"
    )


def add_event(
    events: List[str],
    day: dt.date,
    name: str,
    category: str
):

    start = day.strftime(
        "%Y%m%d"
    )

    end = (
        day
        + dt.timedelta(days=1)
    ).strftime(
        "%Y%m%d"
    )

    uid = make_uid(
        day,
        name,
        category
    )

    events.extend(
        [
            "BEGIN:VEVENT",
            f"UID:{uid}",
            f"DTSTAMP:{dt.datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')}",
            f"DTSTART;VALUE=DATE:{start}",
            f"DTEND;VALUE=DATE:{end}",
            f"SUMMARY:{ics_escape(name)}",
            "END:VEVENT"
        ]
    )


# ============================================================
# 建立 ICS
# ============================================================

def generate_ics(
    official_events,
    family_events,
    kaohsiung_events
):

    events = []

    # --------------------------------------------------------
    # 官方國定假日
    # --------------------------------------------------------

    for day, name in official_events:

        add_event(
            events,
            day,
            name,
            "official"
        )

    # --------------------------------------------------------
    # 母親節 / 父親節
    # --------------------------------------------------------

    for day, name in family_events:

        add_event(
            events,
            day,
            name,
            "family"
        )

    # --------------------------------------------------------
    # 高雄停班停課
    # --------------------------------------------------------

    for day, name in kaohsiung_events:

        add_event(
            events,
            day,
            name,
            "kaohsiung"
        )

    calendar = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Shadel11//Taiwan Life Calendar//ZH-TW",
        "CALSCALE:GREGORIAN",
        "METHOD:PUBLISH",
        "X-WR-CALNAME:台灣生活行事曆",
        "X-WR-TIMEZONE:Asia/Taipei",
        "BEGIN:VTIMEZONE",
        "TZID:Asia/Taipei",
        "BEGIN:STANDARD",
        "DTSTART:19700101T000000",
        "TZOFFSETFROM:+0800",
        "TZOFFSETTO:+0800",
        "TZNAME:CST",
        "END:STANDARD",
        "END:VTIMEZONE"
    ]

    calendar.extend(
        events
    )

    calendar.append(
        "END:VCALENDAR"
    )

    content = (
        "\r\n".join(
            calendar
        )
        + "\r\n"
    )

    with open(
        OUTPUT_FILE,
        "w",
        encoding="utf-8",
        newline=""
    ) as file:

        file.write(
            content
        )

    print()
    print(
        "taiwan.ics 產生完成！"
    )

    print(
        f"共 {len(events)} 個行事曆事件"
    )


# ============================================================
# 主程式
# ============================================================

def main():

    current_year = dt.date.today().year

    years = [
        current_year,
        current_year + 1
    ]

    # --------------------------------------------------------
    # 官方假日
    # --------------------------------------------------------

    official_events = []

    for year in years:

        official_events.extend(
            get_official_holidays(
                year
            )
        )

    # --------------------------------------------------------
    # 母親節 / 父親節
    # --------------------------------------------------------

    family_events = []

    for year in years:

        family_events.extend(
            get_family_days(
                year
            )
        )

    # --------------------------------------------------------
    # 高雄停班停課
    # --------------------------------------------------------

    kaohsiung_events = (
        get_kaohsiung_disaster_days()
    )

    # --------------------------------------------------------
    # 去重
    # --------------------------------------------------------

    official_events = list(
        dict.fromkeys(
            official_events
        )
    )

    family_events = list(
        dict.fromkeys(
            family_events
        )
    )

    kaohsiung_events = list(
        dict.fromkeys(
            kaohsiung_events
        )
    )

    # --------------------------------------------------------
    # 排序
    # --------------------------------------------------------

    official_events.sort(
        key=lambda item: item[0]
    )

    family_events.sort(
        key=lambda item: item[0]
    )

    kaohsiung_events.sort(
        key=lambda item: item[0]
    )

    # --------------------------------------------------------
    # 最終統計
    # --------------------------------------------------------

    print()
    print(
        "========== 最終統計 =========="
    )

    for year in years:

        count = sum(
            1
            for day, _
            in official_events
            if day.year == year
        )

        print(
            f"[統計] {year} "
            f"國定假日/節慶/補假："
            f"{count} 筆"
        )

    mothers = sum(
        1
        for _, name
        in family_events
        if name == "母親節"
    )

    fathers = sum(
        1
        for _, name
        in family_events
        if name == "父親節"
    )

    print(
        f"[統計] 母親節："
        f"{mothers} 筆"
    )

    print(
        f"[統計] 父親節："
        f"{fathers} 筆"
    )

    print(
        f"[統計] 高雄停班停課："
        f"{len(kaohsiung_events)} 筆"
    )

    total = (
        len(official_events)
        + len(family_events)
        + len(kaohsiung_events)
    )

    print(
        f"[統計] 總行事曆事件："
        f"{total} 個"
    )

    print(
        "=============================="
    )

    # --------------------------------------------------------
    # 產生 ICS
    # --------------------------------------------------------

    generate_ics(
        official_events,
        family_events,
        kaohsiung_events
    )


if __name__ == "__main__":
    main()
