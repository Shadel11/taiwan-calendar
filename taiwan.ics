import csv
import io
import json
import re
import ssl
import urllib.parse
import urllib.request
from datetime import date, timedelta


CALENDAR_NAME = "🇹🇼 台灣生活行事曆"

DATASET_DETAIL_URL = (
    "https://data.gov.tw/api/front/dataset/detail"
)

DATASET_NID = "14718"

KAOHSIUNG_DATASET_URL = (
    "https://data.gov.tw/api/front/dataset/detail"
)

KAOHSIUNG_DATASET_NID = "127872"


# ============================================================
# 網路設定
# ============================================================

def build_ssl_context():
    """
    GitHub Actions 的 Python / OpenSSL 有時會對政府網站
    舊式憑證鏈比較嚴格，因此放寬 VERIFY_X509_STRICT，
    但仍然保留憑證驗證與主機名稱驗證。
    """

    context = ssl.create_default_context()

    if hasattr(ssl, "VERIFY_X509_STRICT"):
        context.verify_flags &= ~ssl.VERIFY_X509_STRICT

    return context


SSL_CONTEXT = build_ssl_context()


def fetch_text(url, method="GET", timeout=60):
    request = urllib.request.Request(
        url,
        method=method,
        headers={
            "User-Agent": (
                "Mozilla/5.0 "
                "Taiwan-Life-Calendar-GitHub"
            ),
            "Accept": "*/*",
        },
    )

    with urllib.request.urlopen(
        request,
        timeout=timeout,
        context=SSL_CONTEXT
    ) as response:

        raw = response.read()

    return raw


def fetch_json(url, method="GET", timeout=90):

    raw = fetch_text(
        url,
        method=method,
        timeout=timeout
    )

    text = raw.decode(
        "utf-8-sig",
        errors="replace"
    )

    return json.loads(text)


# ============================================================
# 日期處理
# ============================================================

def normalize_date(value):

    value = str(value).strip()

    # YYYYMMDD
    match = re.match(
        r"^(\d{4})(\d{2})(\d{2})$",
        value
    )

    if match:

        try:

            d = date(
                int(match.group(1)),
                int(match.group(2)),
                int(match.group(3))
            )

            return d.isoformat()

        except ValueError:

            return None

    # YYYY/MM/DD 或 YYYY-MM-DD
    match = re.match(
        r"^(\d{4})[/-](\d{1,2})[/-](\d{1,2})",
        value
    )

    if match:

        try:

            d = date(
                int(match.group(1)),
                int(match.group(2)),
                int(match.group(3))
            )

            return d.isoformat()

        except ValueError:

            return None

    return None


# ============================================================
# 官方政府行政機關辦公日曆
# ============================================================

def get_dataset_resources(dataset_id):

    url = (
        f"{DATASET_DETAIL_URL}"
        f"?nid={dataset_id}"
    )

    data = fetch_json(url)

    if not isinstance(data, dict):
        return []

    payload = data.get("payload") or {}

    resources = payload.get(
        "resources"
    ) or []

    return resources


def find_calendar_resource(year):

    roc_year = str(
        year - 1911
    )

    resources = get_dataset_resources(
        DATASET_NID
    )

    candidates = []

    for resource in resources:

        description = str(
            resource.get("description")
            or resource.get("name")
            or ""
        )

        # 只找該年度
        if roc_year not in description:
            continue

        # 排除 Google 專用版本
        if "Google" in description:
            continue

        candidates.append(
            resource
        )

    # 優先 CSV
    for resource in candidates:

        description = str(
            resource.get("description")
            or ""
        )

        if "CSV" in description.upper():

            return resource

    if candidates:

        return candidates[0]

    return None


def get_resource_download_url(resource):

    """
    data.gov.tw 資源的網址可能放在：
    quality_download / file / URL
    """

    if not resource:
        return None

    quality_download = (
        resource.get("quality_download")
        or {}
    )

    file_info = (
        resource.get("file")
        or {}
    )

    # JSON
    for container in [
        quality_download,
        file_info,
    ]:

        if isinstance(container, dict):

            for key in [
                "csv",
                "CSV",
                "url",
                "URL",
            ]:

                value = container.get(key)

                if value:
                    return value

    for key in [
        "URL",
        "url",
        "download_url",
        "downloadUrl",
    ]:

        value = resource.get(key)

        if value:
            return value

    return None


def decode_csv(raw):

    # 官方 115 / 116 目前為 UTF-8 BOM
    # 但舊年度可能是 Big5，
    # 所以準備多個 fallback。

    encodings = [
        "utf-8-sig",
        "utf-8",
        "cp950",
        "big5",
    ]

    for encoding in encodings:

        try:

            return raw.decode(
                encoding
            )

        except UnicodeDecodeError:

            continue

    return raw.decode(
        "utf-8",
        errors="replace"
    )


def get_official_holidays(year):

    resource = find_calendar_resource(
        year
    )

    if not resource:

        print(
            f"[ERROR] 找不到 {year} "
            "官方辦公日曆資源"
        )

        return []

    description = str(
        resource.get("description")
        or resource.get("name")
        or ""
    )

    print(
        f"[官方資料] {year}："
        f"{description}"
    )

    url = get_resource_download_url(
        resource
    )

    if not url:

        print(
            f"[ERROR] {year} 找不到下載網址"
        )

        return []

    print(
        f"[官方 CSV] {url}"
    )

    try:

        raw = fetch_text(
            url,
            timeout=90
        )

    except Exception as error:

        print(
            f"[ERROR] {year} CSV 下載失敗："
            f"{error}"
        )

        return []

    text = decode_csv(raw)

    reader = csv.DictReader(
        io.StringIO(text)
    )

    holidays = []

    for row in reader:

        # 官方欄位
        raw_date = (
            row.get("西元日期")
            or row.get("\ufeff西元日期")
            or ""
        ).strip()

        holiday_flag = (
            row.get("是否放假")
            or ""
        ).strip()

        description = (
            row.get("備註")
            or ""
        ).strip()

        event_date = normalize_date(
            raw_date
        )

        if not event_date:
            continue

        # 官方規則：
        # 0 = 上班
        # 2 = 放假
        if holiday_flag != "2":
            continue

        # ------------------------------------------------
        # 顯示名稱
        #
        # 官方「備註」就是最可靠的節日名稱來源。
        # 例如：
        # 春節
        # 228和平紀念日
        # 兒童節
        # 清明節
        # 端午節
        # 中秋節
        # 國慶日
        # 等。
        # ------------------------------------------------

        title = description

        if not title:
            title = "台灣政府放假日"

        # 補假／連假也保留官方名稱
        title = f"🇹🇼 {title}"

        holidays.append({
            "date": event_date,
            "title": title,
            "description": (
                "資料來源："
                "行政院人事行政總處"
                "\n"
                "中華民國政府行政機關辦公日曆表"
            ),
        })

    print(
        f"[完成] {year} 官方放假日："
        f"{len(holidays)} 天"
    )

    return holidays


# ============================================================
# 高雄天然災害停班停課
# ============================================================

def get_kaohsiung_resources():

    url = (
        f"{KAOHSIUNG_DATASET_URL}"
        f"?nid={KAOHSIUNG_DATASET_NID}"
    )

    try:

        data = fetch_json(url)

    except Exception as error:

        print(
            "[高雄] 資料集 metadata 取得失敗："
            f"{error}"
        )

        return []

    if not isinstance(data, dict):
        return []

    payload = data.get("payload") or {}

    resources = payload.get(
        "resources"
    ) or []

    return resources


def get_kaohsiung_data_url():

    resources = get_kaohsiung_resources()

    # 優先 JSON
    for resource in resources:

        description = str(
            resource.get("description")
            or resource.get("name")
            or ""
        )

        if "JSON" not in description.upper():
            continue

        url = get_resource_download_url(
            resource
        )

        if url:
            return url

    # 找不到 JSON 就找任何資源
    for resource in resources:

        url = get_resource_download_url(
            resource
        )

        if url:
            return url

    return None


def get_kaohsiung_closures():

    url = get_kaohsiung_data_url()

    if not url:

        print(
            "[高雄] 找不到官方資料下載網址"
        )

        return []

    print(
        f"[高雄資料] {url}"
    )

    try:

        data = fetch_json(
            url,
            method="GET",
            timeout=90
        )

    except Exception as error:

        print(
            "[高雄] 資料下載失敗："
            f"{error}"
        )

        return []

    records = find_records(
        data
    )

    events = []

    for record in records:

        if not isinstance(record, dict):
            continue

        full_text = json.dumps(
            record,
            ensure_ascii=False
        )

        compact = (
            full_text
            .replace(" ", "")
            .replace("\n", "")
            .replace("\r", "")
        )

        # 必須有停班／停課
        if not any(
            keyword in compact
            for keyword in [
                "停止上班上課",
                "停止上班",
                "停止上課",
                "停班停課",
            ]
        ):
            continue

        # 排除照常
        if any(
            keyword in compact
            for keyword in [
                "照常上班上課",
                "照常上班",
                "照常上課",
            ]
        ):
            continue

        dates = extract_dates(
            record
        )

        for event_date in dates:

            events.append({
                "date": event_date,
                "title": "🌪️ 高雄市停班停課",
                "description": (
                    "資料來源：高雄市政府人事處"
                    "\n天然災害停止上班上課相關訊息"
                    "\n"
                    + format_record(record)
                ),
            })

    print(
        f"[完成] 高雄停班停課："
        f"{len(events)} 筆"
    )

    return events


def find_records(data):

    if isinstance(data, list):
        return data

    if not isinstance(data, dict):
        return []

    preferred_keys = [
        "data",
        "Data",
        "result",
        "Result",
        "records",
        "Records",
        "resultData",
        "ResultData",
    ]

    for key in preferred_keys:

        if key in data:

            result = find_records(
                data[key]
            )

            if result:
                return result

    for value in data.values():

        if isinstance(value, list):

            return value

    return []


def extract_dates(record):

    text = json.dumps(
        record,
        ensure_ascii=False
    )

    dates = set()

    # 西元日期
    western = re.findall(
        r"20\d{2}[/-]\d{1,2}[/-]\d{1,2}",
        text
    )

    for value in western:

        normalized = normalize_date(
            value
        )

        if normalized:
            dates.add(
                normalized
            )

    # 民國日期
    roc = re.findall(
        r"1\d{2}[/-]\d{1,2}[/-]\d{1,2}",
        text
    )

    for value in roc:

        parts = re.split(
            r"[/-]",
            value
        )

        if len(parts) != 3:
            continue

        try:

            year = int(parts[0]) + 1911
            month = int(parts[1])
            day = int(parts[2])

            event_date = date(
                year,
                month,
                day
            )

            dates.add(
                event_date.isoformat()
            )

        except ValueError:

            pass

    return sorted(dates)


# ============================================================
# 母親節
# ============================================================

def mothers_day(year):

    # 五月第二個星期日

    d = date(
        year,
        5,
        1
    )

    while d.weekday() != 6:

        d += timedelta(
            days=1
        )

    return (
        d + timedelta(days=7)
    ).isoformat()


# ============================================================
# ICS
# ============================================================

def escape_ics(value):

    return (
        str(value)
        .replace("\\", "\\\\")
        .replace(";", "\\;")
        .replace(",", "\\,")
        .replace("\n", "\\n")
    )


def make_event(
    uid,
    event_date,
    title,
    description
):

    d = date.fromisoformat(
        event_date
    )

    end_date = (
        d + timedelta(days=1)
    )

    return "\r\n".join([
        "BEGIN:VEVENT",
        f"UID:{uid}@taiwan-calendar",
        (
            "DTSTART;VALUE=DATE:"
            f"{d.strftime('%Y%m%d')}"
        ),
        (
            "DTEND;VALUE=DATE:"
            f"{end_date.strftime('%Y%m%d')}"
        ),
        f"SUMMARY:{escape_ics(title)}",
        (
            "DESCRIPTION:"
            f"{escape_ics(description)}"
        ),
        "END:VEVENT",
    ])


def format_record(record):

    if not isinstance(record, dict):
        return str(record)

    parts = []

    for key, value in record.items():

        if value is None:
            continue

        value = str(
            value
        ).strip()

        if not value:
            continue

        parts.append(
            f"{key}：{value}"
        )

    return "\n".join(parts)


# ============================================================
# 產生完整行事曆
# ============================================================

def generate_calendar():

    today = date.today()

    years = [
        today.year,
        today.year + 1,
    ]

    events = []

    # --------------------------------------------------------
    # 官方國定假日
    # --------------------------------------------------------

    for year in years:

        try:

            holidays = (
                get_official_holidays(
                    year
                )
            )

            for item in holidays:

                events.append(
                    make_event(
                        f"official-{item['date']}",
                        item["date"],
                        item["title"],
                        item["description"]
                    )
                )

        except Exception as error:

            print(
                f"[ERROR] {year} 官方資料："
                f"{error}"
            )

    # --------------------------------------------------------
    # 母親節
    # --------------------------------------------------------

    for year in years:

        event_date = mothers_day(
            year
        )

        events.append(
            make_event(
                f"mothers-day-{year}",
                event_date,
                "❤️ 母親節",
                "備注｜台灣常見慶祝節日，不屬政府國定假日",
            )
        )

    # --------------------------------------------------------
    # 父親節
    # --------------------------------------------------------

    for year in years:

        event_date = (
            f"{year}-08-08"
        )

        events.append(
            make_event(
                f"fathers-day-{year}",
                event_date,
                "💙 父親節",
                "備注｜台灣常見慶祝節日，不屬政府國定假日",
            )
        )

    # --------------------------------------------------------
    # 高雄停班停課
    # --------------------------------------------------------

    try:

        closures = (
            get_kaohsiung_closures()
        )

        for item in closures:

            events.append(
                make_event(
                    (
                        "kaohsiung-"
                        f"{item['date']}"
                    ),
                    item["date"],
                    item["title"],
                    item["description"],
                )
            )

    except Exception as error:

        print(
            f"[ERROR] 高雄停班停課："
            f"{error}"
        )

    # --------------------------------------------------------
    # 去重
    # --------------------------------------------------------

    unique = {}

    for event in events:

        uid = None

        for line in event.split(
            "\r\n"
        ):

            if line.startswith(
                "UID:"
            ):

                uid = line
                break

        if uid:
            unique[uid] = event

    events = list(
        unique.values()
    )

    # --------------------------------------------------------
    # 排序
    # --------------------------------------------------------

    events.sort(
        key=lambda event:
        event.split(
            "DTSTART;VALUE=DATE:"
        )[1].split(
            "\r\n"
        )[0]
    )

    # --------------------------------------------------------
    # VCALENDAR
    # --------------------------------------------------------

    calendar = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        (
            "PRODID:"
            "//Taiwan Life Calendar"
            "//GitHub//ZH-TW"
        ),
        "CALSCALE:GREGORIAN",
        "METHOD:PUBLISH",
        f"X-WR-CALNAME:{CALENDAR_NAME}",
        "X-WR-TIMEZONE:Asia/Taipei",
    ]

    calendar.extend(
        events
    )

    calendar.append(
        "END:VCALENDAR"
    )

    return (
        "\r\n".join(calendar)
        + "\r\n"
    )


# ============================================================
# 執行
# ============================================================

if __name__ == "__main__":

    print("")
    print(
        "=========================================="
    )
    print(
        "🇹🇼 台灣生活行事曆開始更新"
    )
    print(
        "=========================================="
    )

    ics = generate_calendar()

    with open(
        "taiwan.ics",
        "w",
        encoding="utf-8",
        newline=""
    ) as file:

        file.write(ics)

    print("")
    print(
        "=========================================="
    )
    print(
        "✅ taiwan.ics 產生完成"
    )
    print(
        f"✅ 共 {ics.count('BEGIN:VEVENT')} 個行事曆事件"
    )
    print(
        "=========================================="
    )
